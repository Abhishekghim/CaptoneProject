# Copy to .env.local and fill in with your Supabase project's values.
# Required for authentication (login, signup, session/route protection) —
# without these the app cannot sign anyone in. Run database/schema.sql in
# the Supabase SQL editor first so the `profiles` table + RLS policies exist.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Powers the floating AI assistant (app/api/assistant/route.ts). Server-only
# — never prefix with NEXT_PUBLIC_, it must not reach the browser. Without
# this the assistant UI still works but replies with a "not connected yet"
# message. Optional: OPENAI_MODEL to override the default (gpt-4o-mini).
OPENAI_API_KEY=
OPENAI_MODEL=

# Required for the admin "approve referring doctor request" action
# (app/api/admin/doctor-requests/[id]/approve/route.ts), which uses the Auth
# Admin API to invite the doctor's account. Project Settings -> API ->
# service_role (the "secret" key, not anon). Server-only — never prefix with
# NEXT_PUBLIC_ and never import lib/supabase/admin.ts from a client
# component; it bypasses Row-Level Security entirely. Without this, rejecting
# still works but approving a request will fail with a clear error.
# Also used by the reception walk-in patient registration route
# (app/api/reception/patients/register/route.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Powers real outbound email (backend/lib/notifications/email.ts, via Resend
# — resend.com). Server-only. Without this, notification emails are silently
# skipped (logged as "not configured") instead of sent — nothing breaks.
# NOTIFICATIONS_FROM_EMAIL must be a verified sender/domain in your Resend
# account or sends will be rejected by Resend even with a valid key.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# Note: phone verification (frontend/components/shared/PhoneVerificationStep.tsx,
# triggered inline when a patient confirms their first MRI booking) also uses
# Twilio, but its credentials are configured separately in the Supabase
# Dashboard (Authentication -> Providers -> Phone) — not as env vars here.

# Dev/test-only bypass for phone verification — accepts ANY 6-digit code
# instead of a real SMS OTP (see app/api/dev/verify-phone-test/route.ts and
# PhoneVerificationStep.tsx). Set BOTH to "true" together, or neither — the
# server route independently re-checks the non-public var, so the client
# flag alone does nothing. NEVER set these in a real deployment.
PHONE_VERIFICATION_TEST_MODE=
NEXT_PUBLIC_PHONE_VERIFICATION_TEST_MODE=

# Powers real online card payment (backend/lib/stripe.ts, Stripe Checkout —
# stripe.com, test mode is free). Server-only. Without STRIPE_SECRET_KEY,
# the "Pay now" button returns a clean "not available" error instead of
# breaking. STRIPE_WEBHOOK_SECRET is required for app/api/webhooks/stripe to
# accept events — get it from the Stripe Dashboard (or `stripe listen` CLI
# for local testing) when you add a webhook endpoint pointing at
# <your-app-url>/api/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
